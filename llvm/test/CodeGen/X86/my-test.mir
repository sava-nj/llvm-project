# RUN: llc -run-pass=my-pass %s 2>&1 -o /dev/null | FileCheck %s

# CHECK: Function name: zbir
# CHECK-NEXT: - load: 2
# CHECK-NEXT: - store: 4
# CHECK-NEXT: - add: 1
# CHECK-NEXT: ----------------------
# CHECK-NEXT: Function name: main
# CHECK-NEXT: - load: 1
# CHECK-NEXT: - store: 3
# CHECK-NEXT: - add: 0

--- |
  ; ModuleID = '../tmp3/example.ll'
  source_filename = "../tmp3/example.c"
  target datalayout = "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128"
  target triple = "x86_64-unknown-linux-gnu"

  ; Function Attrs: noinline nounwind optnone uwtable
  define dso_local i32 @zbir(i32 noundef %a, i32 noundef %b) #0 {
  entry:
    %a.addr = alloca i32, align 4
    %b.addr = alloca i32, align 4
    %rezultat = alloca i32, align 4
    store i32 %a, ptr %a.addr, align 4
    store i32 %b, ptr %b.addr, align 4
    store i32 0, ptr %rezultat, align 4
    %0 = load i32, ptr %a.addr, align 4
    %1 = load i32, ptr %b.addr, align 4
    %add = add nsw i32 %0, %1
    store i32 %add, ptr %rezultat, align 4
    %2 = load i32, ptr %rezultat, align 4
    ret i32 %2
  }

  ; Function Attrs: noinline nounwind optnone uwtable
  define dso_local i32 @main() #0 {
  entry:
    %retval = alloca i32, align 4
    %var = alloca i32, align 4
    %rez = alloca i32, align 4
    store i32 0, ptr %retval, align 4
    store i32 4, ptr %var, align 4
    %0 = load i32, ptr %var, align 4
    %call = call i32 @zbir(i32 noundef %0, i32 noundef 3)
    store i32 %call, ptr %rez, align 4
    ret i32 0
  }

  attributes #0 = { noinline nounwind optnone uwtable "frame-pointer"="all" "min-legal-vector-width"="0" "no-trapping-math"="true" "stack-protector-buffer-size"="8" "target-cpu"="x86-64" "target-features"="+cmov,+cx8,+fxsr,+mmx,+sse,+sse2,+x87" "tune-cpu"="generic" }

  !llvm.module.flags = !{!0, !1, !2, !3, !4}
  !llvm.ident = !{!5}

  !0 = !{i32 1, !"wchar_size", i32 4}
  !1 = !{i32 8, !"PIC Level", i32 2}
  !2 = !{i32 7, !"PIE Level", i32 2}
  !3 = !{i32 7, !"uwtable", i32 2}
  !4 = !{i32 7, !"frame-pointer", i32 2}
  !5 = !{!"clang version 20.1.8 (git@github.com:sava-nj/llvm-project.git 9e30481f7224b4b3d9a48346da4317ff9d5f8dca)"}

...
---
name:            zbir
alignment:       16
tracksRegLiveness: true
noPhis:          false
isSSA:           true
noVRegs:         false
hasFakeUses:     false
registers:
  - { id: 0, class: gr32 }
  - { id: 1, class: gr32 }
  - { id: 2, class: gr32 }
  - { id: 3, class: gr32 }
  - { id: 4, class: gr32 }
  - { id: 5, class: gr32 }
  - { id: 6, class: gr32 }
  - { id: 7, class: gr32 }
  - { id: 8, class: gr32 }
  - { id: 9, class: gr32 }
  - { id: 10, class: gr32 }
liveins:
  - { reg: '$edi', virtual-reg: '%0' }
  - { reg: '$esi', virtual-reg: '%2' }
frameInfo:
  maxAlignment:    4
stack:
  - { id: 0, name: a.addr, size: 4, alignment: 4 }
  - { id: 1, name: b.addr, size: 4, alignment: 4 }
  - { id: 2, name: rezultat, size: 4, alignment: 4 }
machineFunctionInfo:
  amxProgModel:    None
body:             |
  bb.0.entry:
    liveins: $edi, $esi

    %2:gr32 = COPY $esi
    %0:gr32 = COPY $edi
    %1:gr32 = COPY killed %0
    %3:gr32 = COPY killed %2
    MOV32mr %stack.0.a.addr, 1, $noreg, 0, $noreg, %1 :: (store (s32) into %ir.a.addr)
    MOV32mr %stack.1.b.addr, 1, $noreg, 0, $noreg, %3 :: (store (s32) into %ir.b.addr)
    MOV32mi %stack.2.rezultat, 1, $noreg, 0, $noreg, 0 :: (store (s32) into %ir.rezultat)
    %10:gr32 = MOV32rm %stack.0.a.addr, 1, $noreg, 0, $noreg :: (load (s32) from %ir.a.addr)
    %9:gr32 = ADD32rm %10, %stack.1.b.addr, 1, $noreg, 0, $noreg, implicit-def $eflags :: (load (s32) from %ir.b.addr)
    MOV32mr %stack.2.rezultat, 1, $noreg, 0, $noreg, %9 :: (store (s32) into %ir.rezultat)
    %5:gr32 = MOV32rm %stack.2.rezultat, 1, $noreg, 0, $noreg :: (load (s32) from %ir.rezultat)
    $eax = COPY %5
    RET64 implicit $eax
...
---
name:            main
alignment:       16
tracksRegLiveness: true
noPhis:          false
isSSA:           true
noVRegs:         false
hasFakeUses:     false
registers:
  - { id: 0, class: gr32 }
  - { id: 1, class: gr32 }
  - { id: 2, class: gr32 }
  - { id: 3, class: gr32 }
  - { id: 4, class: gr32 }
  - { id: 5, class: gr32 }
frameInfo:
  maxAlignment:    4
  adjustsStack:    true
  hasCalls:        true
stack:
  - { id: 0, name: retval, size: 4, alignment: 4 }
  - { id: 1, name: var, size: 4, alignment: 4 }
  - { id: 2, name: rez, size: 4, alignment: 4 }
machineFunctionInfo:
  amxProgModel:    None
body:             |
  bb.0.entry:
    MOV32mi %stack.0.retval, 1, $noreg, 0, $noreg, 0 :: (store (s32) into %ir.retval)
    MOV32mi %stack.1.var, 1, $noreg, 0, $noreg, 4 :: (store (s32) into %ir.var)
    %5:gr32 = MOV32rm %stack.1.var, 1, $noreg, 0, $noreg :: (load (s32) from %ir.var)
    %3:gr32 = MOV32ri 3
    ADJCALLSTACKDOWN64 0, 0, 0, implicit-def $rsp, implicit-def $eflags, implicit-def $ssp, implicit $rsp, implicit $ssp
    $edi = COPY %5
    $esi = COPY %3
    CALL64pcrel32 @zbir, csr_64, implicit $rsp, implicit $ssp, implicit $edi, implicit $esi, implicit-def $eax
    ADJCALLSTACKUP64 0, 0, implicit-def $rsp, implicit-def $eflags, implicit-def $ssp, implicit $rsp, implicit $ssp
    %4:gr32 = COPY $eax
    MOV32mr %stack.2.rez, 1, $noreg, 0, $noreg, %4 :: (store (s32) into %ir.rez)
    %0:gr32 = MOV32r0 implicit-def $eflags
    $eax = COPY %0
    RET64 implicit $eax

...
